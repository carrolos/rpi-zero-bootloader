# project source
PROJ_SRC := rpz-install.c rpz-echo.c

# sets objs as the default directory for objects and creates it if
# it doesn't already exist
BUILD_DIR ?= objs
$(BUILD_DIR):
	@mkdir -p $@

LIB := libunix

# adds lib/include to the list of directories to search
# through when resolving #include directives
INC := -I$(LIB)/include -I../shared

# source files that each program depends on
COMMON_SRC := $(wildcard $(LIB)/src/*.c)

# object files that each program depends on
# addprefix prepends the build dir to the files
# patsubst substitutes the file suffix of stems with
# left suffix with right suffix
COMMON_OBJS := $(addprefix $(BUILD_DIR)/, \
				$(patsubst %.c,%.o,$(patsubst %.S,%.o,$(COMMON_SRC))))

ARCHIVE := $(BUILD_DIR)/$(LIB).a

progs := $(addprefix $(BUILD_DIR)/,$(PROJ_SRC:.c=.out))

# handle dependencies with `.d` files generated by the compiler;
# handles automatic recompilation when headers change
DEPS := $(COMMON_OBJS:.o=.d)
DEPS += $(addprefix $(BUILD_DIR)/,$(PROJ_SRC:.c=.d))

# include the `.d` files directly, when they exist
-include $(DEPS)

# disable built-in rules which can result in unexpected results
.SUFFIXES:

# short-hand variables for compilation tools
CC  := gcc # C compiler
AR  := ar # archiver

# dependency flags; these help Make help us
# -MMD: generate a `.d` dependency file from includes that only lists user
#  	headers (not system headers)
# -MP: add empty rules for each header in the `.d` file so Make doesn't break
#  	when a header and all references (i.e., #include) are deleted
# also including $(INC) here because both C and assembly files need them
DFLAGS := -MMD -MP $(INC)

# compiler flags
# note: order matters!
# -g: enable debugging
# -Wall: enable several warnings
# -Wno-unused-variable: negates activiation of warning `Wunused-variable`
#  	enabled by `Wall`
# -Werror: make all warnings into errors
# -std: specify C standard
CFLAGS := -g -Wall -Wno-unused-variable -Werror \
			 -std=gnu99 $(DFLAGS)

# make all programs
all: $(progs)

# build the static archive
$(ARCHIVE): $(COMMON_OBJS)
	@rm -f $@
	$(AR) -cr $@ $(COMMON_OBJS)

$(progs): %.out: %.o $(ARCHIVE)
	$(CC) $< -o $@ $(ARCHIVE)

## .c -> .o
$(BUILD_DIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -rf $(BUILD_DIR)

# tell the Make program that the specified targets aren't real files,
# so to not look for timestamps on them
.PHONY: all clean
